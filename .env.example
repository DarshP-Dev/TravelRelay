# Milestone 1 foundation runs without environment variables.
# Copy to .env.local when implementing the relevant service. Leave secrets server-only.

# App / authentication (future; AUTH_SECRET must be generated locally)
APP_URL=
AUTH_URL=
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# PostgreSQL / Neon (future; use a pooled URL for DATABASE_URL)
DATABASE_URL=
DIRECT_URL=

# PayPal Sandbox ONLY (future; host/credential pairing must be validated server-side)
PAYPAL_ENVIRONMENT=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Only this explicitly public client identifier may later reach the browser.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# FX (future; rates are estimates, never PayPal conversion quotes)
FX_API_BASE_URL=
FX_CACHE_TTL_SECONDS=

# Model adapter (future; model-provider choice is deferred)
MODEL_PROVIDER=
MODEL_NAME=
MODEL_API_KEY=

# Demo merchant controls (future; disabled unless explicitly enabled server-side)
ENABLE_DEMO_MERCHANT=
