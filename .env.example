# Milestone 1B: copy to .env.local or run npm run setup:local.
# Secrets are blank placeholders; provider/model names are non-secret defaults.
# Milestone 3A: Bryntum Community and Leaflet/OSM need no license/API key.
# Map tiles are optional, public browser requests; no geocoding/routing service.

# Current: app origin and Better Auth signing secret (at least 32 random characters)
APP_URL=
AUTH_SECRET=
# Future OAuth providers; not currently connected
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Current: hosted PostgreSQL / Neon. Migration script prefers DIRECT_URL.
DATABASE_URL=
DIRECT_URL=
# Local development only: explicitly select pglite and an ignored .data path.
DATABASE_DRIVER=
LOCAL_DATABASE_PATH=
# Only for local, single-process production-preview QA; never serverless hosting.
ALLOW_LOCAL_DATABASE=

# PayPal Sandbox ONLY (future; host/credential pairing must be validated server-side)
PAYPAL_ENVIRONMENT=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Only this explicitly public client identifier may later reach the browser.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# FX: server-only Frankfurter v2 / ECB, no key required. Fixed official endpoint,
# one-hour persistent cache; timestamps and stale states are preserved.
# Reference rates are estimates, never PayPal conversion quotes or charged FX.

# AI selection is server-controlled and manual. Never use NEXT_PUBLIC_ for keys.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
OPENAI_REASONING_EFFORT=medium
# Google Gemini backup via official @google/genai SDK (server-only).
# Set GEMINI_API_KEY in ignored .env.local; never use NEXT_PUBLIC_ for this key.
# Select explicitly with AI_PROVIDER=gemini. Never an automatic fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Legacy Gemini-only alias, used only if GEMINI_MODEL is unset.
MODEL_NAME=
# Optional shared application limits; defaults: 2/minute, 20/Pacific day, 6/user/hour.
# Shared across BOTH providers. Match to your account limits and cost controls.
# Milestone 3B: these same SQL counters/lease cover generation AND assistant calls.
# The assistant needs no additional API secret. No automatic retries or fallback.
GENERATION_GLOBAL_RPM=
GENERATION_GLOBAL_RPD=
GENERATION_USER_HOURLY_LIMIT=

# Demo merchant controls (future; disabled unless explicitly enabled server-side)
ENABLE_DEMO_MERCHANT=
